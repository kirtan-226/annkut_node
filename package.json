{
  "name": "annkut-backend-node",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js port of the Annkut CodeIgniter 3 backend, packaged for AWS Lambda + API Gateway with RDS MySQL.",
  "main": "src/lambda.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/local.js",
    "dev": "node --watch src/local.js",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.658.1",
    "express": "^4.19.2",
    "mysql2": "^3.11.3",
    "serverless-http": "^3.2.0"
  }
}
