# Annkut backend -- local development configuration.
# Copy to .env and fill in. Never commit the filled-in copy.
#
#   cp .env.example .env
#   npm start
#
# In production none of this is a file: template.yaml sets these as Lambda
# environment variables, and the credentials come from Secrets Manager.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bharuchbaps_annkut_new

# Credentials. Supply EITHER these two (local dev) OR DB_SECRET_ARN (AWS).
DB_USER=root
DB_PASSWORD=

# Secrets Manager secret holding {"username":"...","password":"..."}.
# Takes priority over DB_USER/DB_PASSWORD when set. This is what production
# uses; leave it empty locally.
# DB_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789012:secret:annkut/db-AbCdEf

# TLS to the database. Off for a local MySQL, on for RDS.
DB_SSL=false

# Connections per pool. Kept small on Lambda: every concurrent execution
# environment holds its own pool, so this number multiplies into RDS.
DB_POOL_SIZE=2
DB_CONNECT_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001

# Decides which row of sevak_targets / mandal_targets counts as "this year".
# The old cPanel host ran on India time; keep this matched to it or writes made
# near midnight on 31 December land on the wrong year.
APP_TIMEZONE=Asia/Kolkata

# Origins allowed to call the API with credentials, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://master.d3lfyncl45ukvr.amplifyapp.com

# Return SQL error details in responses. Development only -- these leak schema.
EXPOSE_ERRORS=true
